                    <span class="section-label">Cidade</span>
                    <input type="text" id="novo_cidade" placeholder="Cidade" class="w-full p-2.5 rounded-xl">
                </div>
                <div>
                    <span class="section-label">Estado</span>
                    <input type="text" id="novo_estado" placeholder="SC" class="w-full p-2.5 rounded-xl">
                </div>
            </div>
 
            <button type="button" onclick="salvarNovoCliente()" class="w-full bg-green-600 hover:bg-green-500 text-white font-black py-2 rounded-xl uppercase text-sm transition-colors mt-4">
                Salvar Cliente
            </button>
        </div>
    </div>
</div>
 
<div class="max-w-4xl mx-auto mb-12">
 
    <!-- Header -->
    <div class="glass rounded-2xl p-5 mb-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="bg-blue-600/20 p-2.5 rounded-xl">
                <i data-lucide="shopping-cart" class="text-blue-400 w-5 h-5"></i>
            </div>
            <div>
                <h1 class="text-xl font-black tracking-tight text-white">BOTTMANN</h1>
                <p class="text-[10px] text-blue-200 uppercase font-bold tracking-widest">Nova Venda</p>
            </div>
        </div>
        <a href="log_vendas.html" class="flex items-center gap-1.5 text-[10px] font-black text-blue-300 hover:text-blue-200 uppercase tracking-widest border border-blue-800/50 hover:border-blue-500/40 rounded-xl px-3 py-2 transition-all">
            <i data-lucide="list" class="w-3.5 h-3.5"></i> Ver vendas
        </a>
    </div>
 
    <!-- Formulário -->
    <form id="formVenda" class="space-y-3">
 
        <!-- Data e Pagamento -->
        <div class="glass rounded-2xl p-4">
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <span class="section-label">Data da venda</span>
                    <input type="date" id="data_venda" class="w-full p-2.5 rounded-xl text-xs">
                </div>
                <div>
                    <span class="section-label">Pagamento</span>
                    <select id="pagamento" class="w-full p-2.5 rounded-xl text-xs">
                        <option value="Dinheiro">💵 Dinheiro</option>
                        <option value="Débito">🏧 Débito</option>
                        <option value="Crédito">💳 Crédito</option>
                        <option value="Pix">📱 Pix</option>
                    </select>
                </div>
            </div>
        </div>
 
        <!-- Cliente -->
        <div class="glass rounded-2xl p-4">
            <p class="section-label text-blue-300 mb-3">CLIENTE</p>
            
            <div class="grid grid-cols-2 gap-3 mb-3">
                <div>
                    <span class="section-label">Buscar cliente existente</span>
                    <div class="relative">
                        <i data-lucide="search" class="absolute left-3 top-3 w-4 h-4 text-blue-500 pointer-events-none"></i>
                        <input type="text" id="busca_cliente" placeholder="Nome, CPF ou celular..."
                               class="w-full p-2.5 pl-10 rounded-xl" 
                               onkeydown="if(event.key==='Enter'){buscarCliente(this.value)}">
                        <button type="button" onclick="buscarCliente(document.getElementById('busca_cliente').value)"
                                class="absolute right-2 top-1.5 px-2 py-1 bg-blue-600 hover:bg-blue-500 text-white text-[9px] font-black rounded-lg transition-colors uppercase">
                            Buscar
                        </button>
                    </div>
                </div>
                <button type="button" onclick="abrirModalNovoCliente()" class="w-full bg-green-600 hover:bg-green-500 text-white text-[10px] font-black rounded-xl px-3 py-2.5 transition-colors uppercase mt-5 flex items-center justify-center gap-2">
                    <i data-lucide="plus" class="w-4 h-4"></i> Novo Cliente
                </button>
            </div>
 
            <!-- Dados Cliente -->
            <div class="space-y-2">
                <div>
                    <span class="section-label">Nome completo</span>
                    <input type="text" id="nome_cliente" placeholder="Nome completo" class="w-full p-2.5 rounded-xl" readonly>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <span class="section-label">CPF / CNPJ</span>
                        <input type="text" id="doc_cliente" placeholder="000.000.000-00" class="w-full p-2.5 rounded-xl" readonly>
                    </div>
                    <div>
                        <span class="section-label">Celular</span>
                        <input type="text" id="celular_cliente" placeholder="(00) 00000-0000" class="w-full p-2.5 rounded-xl" readonly>
                    </div>
                </div>
                <div>
                    <span class="section-label">CEP</span>
                    <input type="text" id="cep_cliente" class="w-full p-2.5 rounded-xl" readonly>
                </div>
                <div>
                    <span class="section-label">Endereço</span>
                    <input type="text" id="endereco_cliente" class="w-full p-2.5 rounded-xl" readonly>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <span class="section-label">Número</span>
                        <input type="text" id="numero_cliente" class="w-full p-2.5 rounded-xl" readonly>
                    </div>
                    <div>
                        <span class="section-label">Complemento</span>
                        <input type="text" id="complemento_cliente" class="w-full p-2.5 rounded-xl" readonly>
                    </div>
                </div>
                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <span class="section-label">Bairro</span>
                        <input type="text" id="bairro_cliente" class="w-full p-2.5 rounded-xl" readonly>
                    </div>
                    <div>
                        <span class="section-label">Cidade</span>
                        <input type="text" id="cidade_cliente" class="w-full p-2.5 rounded-xl" readonly>
                    </div>
                    <div>
                        <span class="section-label">Estado</span>
                        <input type="text" id="estado_cliente" class="w-full p-2.5 rounded-xl" readonly>
                    </div>
                </div>
            </div>
        </div>
 
        <!-- Produtos -->
        <div class="glass rounded-2xl p-4 space-y-3">
            <p class="section-label text-blue-300 mb-3">PRODUTOS</p>
            
            <div class="grid grid-cols-2 gap-2 mb-3">
                <div>
                    <span class="section-label">Código do produto</span>
                    <input type="text" id="codigo_produto" placeholder="Ex: PROD001" class="w-full p-2.5 rounded-xl text-xs">
                </div>
                <div>
                    <button type="button" onclick="buscarProduto()" class="w-full bg-blue-600 hover:bg-blue-500 text-white text-[10px] font-black rounded-xl px-3 py-2.5 transition-colors uppercase mt-5">
                        <i data-lucide="search" class="w-3 h-3 inline mr-1"></i> Buscar
                    </button>
                </div>
            </div>
 
            <div id="info-produto" style="display:none;" class="glass rounded-xl p-3 mb-3 text-xs">
                <div class="grid grid-cols-3 gap-2">
                    <div>
                        <span class="section-label">Produto</span>
                        <p id="info-nome" class="text-white font-bold text-sm">-</p>
                    </div>
                    <div>
                        <span class="section-label">Em estoque</span>
                        <p id="info-estoque" class="text-white font-bold text-sm text-blue-400">-</p>
                    </div>
                    <div>
                        <span class="section-label">Valor</span>
                        <p id="info-preco" class="text-white font-bold text-sm">-</p>
                    </div>
                </div>
            </div>
 
            <div id="add-quantidade" style="display:none;" class="grid grid-cols-3 gap-2 mb-3">
                <div class="col-span-2">
                    <span class="section-label">Quantidade</span>
                    <input type="number" id="qtd_produto" min="1" value="1" class="w-full p-2.5 rounded-xl text-xs">
                </div>
                <button type="button" onclick="adicionarProduto()" class="w-full bg-blue-600 hover:bg-blue-500 text-white text-[10px] font-black rounded-xl transition-colors uppercase mt-5">
                    <i data-lucide="plus" class="w-3 h-3 inline"></i> Add
                </button>
            </div>
 
            <!-- Tabela de Produtos -->
            <div id="lista-produtos" class="space-y-2 overflow-x-auto">
                <!-- Preenchido por JavaScript -->
            </div>
        </div>
 
        <!-- Observações -->
        <div class="glass rounded-2xl p-4">
            <span class="section-label">Observações (opcional)</span>
            <textarea id="observacoes" placeholder="Alguma observação..." class="w-full p-2.5 rounded-xl h-16"></textarea>
        </div>
 
        <!-- Totalizadores -->
        <div class="glass rounded-2xl p-5">
            <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between text-blue-300">
                    <span>Itens:</span>
                    <span id="total-itens" class="font-bold">0</span>
                </div>
                <div class="flex justify-between text-blue-300">
                    <span>Quantidade:</span>
                    <span id="total-quantidade" class="font-bold">0</span>
                </div>
                <div id="desconto-div" style="display:none;" class="flex justify-between text-green-400">
                    <span>Desconto total:</span>
                    <span id="total-desconto" class="font-bold">R$ 0,00</span>
                </div>
                <div class="border-t border-blue-900 pt-2 flex justify-between text-white text-lg font-black">
                    <span>Total:</span>
                    <span id="total-venda" class="text-blue-400">R$ 0,00</span>
                </div>
            </div>
        </div>
 
        <!-- Ações -->
        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-black py-4 rounded-2xl flex items-center justify-center gap-2 uppercase text-sm transition-colors">
            <i data-lucide="save" class="w-4 h-4"></i> Salvar venda
        </button>
 
    </form>
</div>
 
<script>
    const loading = document.getElementById('loadingOverlay');
    const loadingStatus = document.getElementById('loadingStatus');
    
    const URL_CLIENTES = "COLOQUE_AQUI_A_URL_DO_SCRIPT_DE_CLIENTES";
    const URL_ESTOQUE = "COLOQUE_AQUI_A_URL_DO_SCRIPT_DE_ESTOQUE";
    const URL_SALVAR_VENDA = "COLOQUE_AQUI_A_URL_DO_SCRIPT_PARA_SALVAR_VENDA";
 
    const ABA_CLIENTES = "CONTATOS";
    const ABA_ESTOQUE = "ESTOQUE";
    const ABA_VENDAS = "VENDA";
 
    document.getElementById('data_venda').valueAsDate = new Date();
 
    let produtosAdicionados = [];
    let produtoAtual = null;
 
    function abrirModalNovoCliente() {
        document.getElementById('modalNovoCliente').classList.add('active');
    }
 
    function fecharModalNovoCliente() {
        document.getElementById('modalNovoCliente').classList.remove('active');
    }
 
    function buscarCEP() {
        const cep = document.getElementById('novo_cep').value.replace(/\D/g, '');
        if (cep.length !== 8) return;
        fetch(`https://viacep.com.br/ws/${cep}/json/`)
            .then(res => res.json())
            .then(data => {
                if (!data.erro) {
                    document.getElementById('novo_endereco').value = data.logradouro;
                    document.getElementById('novo_bairro').value = data.bairro;
                    document.getElementById('novo_cidade').value = data.localidade;
                    document.getElementById('novo_estado').value = data.uf;
                }
            })
            .catch(e => console.log('Erro CEP'));
    }
 
    function salvarNovoCliente() {
        const nome = document.getElementById('novo_nome').value;
        const doc = document.getElementById('novo_doc').value;
        const celular = document.getElementById('novo_celular').value;
        const cep = document.getElementById('novo_cep').value;
        const endereco = document.getElementById('novo_endereco').value;
        const numero = document.getElementById('novo_numero').value;
        const complemento = document.getElementById('novo_complemento').value;
        const bairro = document.getElementById('novo_bairro').value;
        const cidade = document.getElementById('novo_cidade').value;
        const estado = document.getElementById('novo_estado').value;
 
        if (!nome || !celular) {
            alert("Preencha Nome e Celular");
            return;
        }
 
        document.getElementById('nome_cliente').value = nome;
        document.getElementById('doc_cliente').value = doc;
        document.getElementById('celular_cliente').value = celular;
        document.getElementById('cep_cliente').value = cep;
        document.getElementById('endereco_cliente').value = endereco;
        document.getElementById('numero_cliente').value = numero;
        document.getElementById('complemento_cliente').value = complemento;
        document.getElementById('bairro_cliente').value = bairro;
        document.getElementById('cidade_cliente').value = cidade;
        document.getElementById('estado_cliente').value = estado;
 
        fecharModalNovoCliente();
        alert("✅ Cliente cadastrado!");
    }
 
    async function buscarCliente(termo) {
        if (!termo || termo.length < 3) return;
        loadingStatus.innerText = 'Buscando...';
        loading.style.display = 'flex';
        try {
            const res = await fetch(URL_CLIENTES, { 
                method: 'POST', 
                body: JSON.stringify({ acao: "buscar", termo, aba: ABA_CLIENTES }) 
            });
            const d = await res.json();
            if (d.status === "encontrado") {
                document.getElementById('nome_cliente').value = d.cliente.nome || "";
                document.getElementById('doc_cliente').value = d.cliente.doc || "";
                document.getElementById('celular_cliente').value = d.cliente.cel1 || "";
                document.getElementById('cep_cliente').value = d.cliente.cep || "";
                document.getElementById('endereco_cliente').value = d.cliente.end || "";
                document.getElementById('numero_cliente').value = d.cliente.num || "";
                document.getElementById('complemento_cliente').value = d.cliente.comp || "";
                document.getElementById('bairro_cliente').value = d.cliente.bairro || "";
                document.getElementById('cidade_cliente').value = d.cliente.cid || "";
                document.getElementById('estado_cliente').value = d.cliente.uf || "";
                alert("✅ Cliente encontrado!");
            } else {
                alert("Cliente não encontrado. Use 'Novo Cliente'.");
            }
        } catch(e) { 
            alert("Erro ao buscar cliente");
        }
        loading.style.display = 'none';
    }
 
    async function buscarProduto() {
        const codigo = document.getElementById('codigo_produto').value;
        if (!codigo) { alert("Digite o código"); return; }
        
        loadingStatus.innerText = 'Buscando...';
        loading.style.display = 'flex';
        
        try {
            const res = await fetch(URL_ESTOQUE, { 
                method: 'POST', 
                body: JSON.stringify({ acao: "buscar", codigo, aba: ABA_ESTOQUE }) 
            });
            const d = await res.json();
            if (d.status === "encontrado") {
                produtoAtual = d.produto;
                document.getElementById('info-nome').innerText = d.produto.nome;
                document.getElementById('info-estoque').innerText = d.produto.quantidade + " un";
                document.getElementById('info-preco').innerText = "R$ " + parseFloat(d.produto.valor).toFixed(2).replace('.', ',');
                document.getElementById('info-produto').style.display = 'block';
                document.getElementById('add-quantidade').style.display = 'grid';
                document.getElementById('qtd_produto').max = d.produto.quantidade;
            } else {
                alert("Produto não encontrado");
                document.getElementById('info-produto').style.display = 'none';
                document.getElementById('add-quantidade').style.display = 'none';
            }
        } catch(e) { 
            alert("Erro ao buscar");
        }
        loading.style.display = 'none';
    }
 
    function adicionarProduto() {
        if (!produtoAtual) return;
        const qtd = parseInt(document.getElementById('qtd_produto').value);
        if (qtd <= 0) { alert("Quantidade inválida"); return; }
 
        produtosAdicionados.push({
            codigo: produtoAtual.codigo,
            nome: produtoAtual.nome,
            especificacao: produtoAtual.especificacao || "",
            cor: produtoAtual.cor || "",
            quantidade: qtd,
            valor_unitario: parseFloat(produtoAtual.valor),
            desconto_percentual: 0,
            desconto_valor: 0
        });
 
        document.getElementById('codigo_produto').value = '';
        produtoAtual = null;
        document.getElementById('info-produto').style.display = 'none';
        document.getElementById('add-quantidade').style.display = 'none';
        
        renderizarProdutos();
    }
 
    function removerProduto(index) {
        produtosAdicionados.splice(index, 1);
        renderizarProdutos();
    }
 
    function renderizarProdutos() {
        const lista = document.getElementById('lista-produtos');
        if (produtosAdicionados.length === 0) {
            lista.innerHTML = '<p class="text-blue-400 text-xs text-center py-4">Nenhum produto</p>';
        } else {
            let html = `<table class="tabela-produtos"><thead><tr>
                <th>Nº</th><th>Descrição</th><th>SKU</th><th>Qtd</th><th>Preço</th>
                <th>Desc(%)</th><th>Desc(R$)</th><th>Final</th><th>X</th>
            </tr></thead><tbody>`;
 
            produtosAdicionados.forEach((p, i) => {
                let desc = p.nome;
                if (p.especificacao) desc += ` - ${p.especificacao}`;
                if (p.cor) desc += ` (${p.cor})`;
 
                const precoOrig = parseFloat(p.valor_unitario) || 0;
                const desc_perc = parseFloat(p.desconto_percentual) || 0;
                const desc_valor = parseFloat(p.desconto_valor) || 0;
                
                let precoFinal = precoOrig;
                if (desc_perc > 0) precoFinal = precoOrig * (1 - desc_perc / 100);
                else if (desc_valor > 0) precoFinal = precoOrig - desc_valor;
                precoFinal = Math.max(0, precoFinal);
 
                html += `<tr>
                    <td>${i + 1}</td>
                    <td style="font-size:10px" class="text-blue-300">${desc}</td>
                    <td class="text-blue-400"><strong>${p.codigo}</strong></td>
                    <td><strong>${p.quantidade}</strong></td>
                    <td>R$ ${precoOrig.toFixed(2).replace('.', ',')}</td>
                    <td><input type="number" class="desconto-input" value="${desc_perc}" min="0" max="100" step="0.01" onchange="atualizarDesconto(${i}, 'percentual', this.value)"></td>
                    <td><input type="number" class="desconto-input" value="${desc_valor.toFixed(2)}" min="0" step="0.01" onchange="atualizarDesconto(${i}, 'valor', this.value)"></td>
                    <td class="text-blue-400 font-bold">R$ ${precoFinal.toFixed(2).replace('.', ',')}</td>
                    <td><button type="button" onclick="removerProduto(${i})" class="btn-remove">🗑️</button></td>
                </tr>`;
            });
 
            html += `</tbody></table>`;
            lista.innerHTML = html;
        }
 
        atualizarTotais();
        lucide.createIcons();
    }
 
    function atualizarDesconto(index, tipo, valor) {
        if (tipo === 'percentual') {
            produtosAdicionados[index].desconto_percentual = parseFloat(valor) || 0;
            produtosAdicionados[index].desconto_valor = 0;
        } else {
            produtosAdicionados[index].desconto_valor = parseFloat(valor) || 0;
            produtosAdicionados[index].desconto_percentual = 0;
        }
        renderizarProdutos();
    }
 
    function atualizarTotais() {
        let totalItens = produtosAdicionados.length;
        let totalQtd = 0;
        let totalVenda = 0;
        let totalDesc = 0;
 
        produtosAdicionados.forEach(p => {
            totalQtd += p.quantidade;
            const precoOrig = parseFloat(p.valor_unitario) || 0;
            const desc_perc = parseFloat(p.desconto_percentual) || 0;
            const desc_valor = parseFloat(p.desconto_valor) || 0;
            
            let precoFinal = precoOrig;
            if (desc_perc > 0) {
                precoFinal = precoOrig * (1 - desc_perc / 100);
                totalDesc += (precoOrig - precoFinal) * p.quantidade;
            } else if (desc_valor > 0) {
                precoFinal = precoOrig - desc_valor;
                totalDesc += desc_valor * p.quantidade;
            }
            
            precoFinal = Math.max(0, precoFinal);
            totalVenda += precoFinal * p.quantidade;
        });
 
        document.getElementById('total-itens').innerText = totalItens;
        document.getElementById('total-quantidade').innerText = totalQtd;
        document.getElementById('total-venda').innerText = "R$ " + totalVenda.toFixed(2).replace('.', ',');
        
        if (totalDesc > 0) {
            document.getElementById('desconto-div').style.display = 'flex';
            document.getElementById('total-desconto').innerText = "R$ " + totalDesc.toFixed(2).replace('.', ',');
        } else {
            document.getElementById('desconto-div').style.display = 'none';
        }
    }
 
    document.getElementById('formVenda').onsubmit = async (e) => {
        e.preventDefault();
 
        if (!document.getElementById('nome_cliente').value) {
            alert("Selecione um cliente");
            return;
        }
 
        if (produtosAdicionados.length === 0) {
            alert("Adicione produtos");
            return;
        }
 
        loading.style.display = 'flex';
        loadingStatus.innerText = 'Salvando...';
 
        try {
            let totalVenda = 0;
            let totalDesc = 0;
 
            const produtos = produtosAdicionados.map(p => {
                const precoOrig = parseFloat(p.valor_unitario) || 0;
                const desc_perc = parseFloat(p.desconto_percentual) || 0;
                const desc_valor = parseFloat(p.desconto_valor) || 0;
                
                let precoFinal = precoOrig;
                if (desc_perc > 0) {
                    precoFinal = precoOrig * (1 - desc_perc / 100);
                    totalDesc += (precoOrig - precoFinal) * p.quantidade;
                } else if (desc_valor > 0) {
                    precoFinal = precoOrig - desc_valor;
                    totalDesc += desc_valor * p.quantidade;
                }
                
                precoFinal = Math.max(0, precoFinal);
                totalVenda += precoFinal * p.quantidade;
 
                return {
                    codigo: p.codigo, nome: p.nome, especificacao: p.especificacao, cor: p.cor,
                    quantidade: p.quantidade, valor_unitario: precoOrig,
                    desconto_percentual: desc_perc, desconto_valor: desc_valor,
                    valor_final: precoFinal, subtotal: precoFinal * p.quantidade
                };
            });
 
            const dados = {
                acao: "salvar", aba: ABA_VENDAS,
                data: document.getElementById('data_venda').value,
                cliente_nome: document.getElementById('nome_cliente').value,
                cliente_doc: document.getElementById('doc_cliente').value,
                cliente_celular: document.getElementById('celular_cliente').value,
                cliente_cep: document.getElementById('cep_cliente').value,
                cliente_endereco: document.getElementById('endereco_cliente').value,
                cliente_numero: document.getElementById('numero_cliente').value,
                cliente_complemento: document.getElementById('complemento_cliente').value,
                cliente_bairro: document.getElementById('bairro_cliente').value,
                cliente_cidade: document.getElementById('cidade_cliente').value,
                cliente_estado: document.getElementById('estado_cliente').value,
                produtos: JSON.stringify(produtos),
                qtd_total: produtosAdicionados.reduce((a, p) => a + p.quantidade, 0),
                valor_total: totalVenda,
                desconto_total: totalDesc,
                pagamento: document.getElementById('pagamento').value,
                observacoes: document.getElementById('observacoes').value
            };
 
            const res = await fetch(URL_SALVAR_VENDA, {method: 'POST', body: JSON.stringify(dados)});
            const resultado = await res.json();
 
            loading.style.display = 'none';
            if (resultado.status === "sucesso") {
                alert(`✅ Venda #${resultado.id}\n💰 Desconto: R$ ${totalDesc.toFixed(2).replace('.', ',')}\n📊 Total: R$ ${totalVenda.toFixed(2).replace('.', ',')}`);
                if (confirm("Ver todas as vendas?")) window.location.href = 'log_vendas.html';
                else location.reload();
            } else {
                alert("Erro: " + (resultado.mensagem || "Desconhecido"));
            }
        } catch(err) {
            loading.style.display = 'none';
            alert("Erro de conexão");
        }
    };
 
    lucide.createIcons();
</script>
</body>
</html>
 


